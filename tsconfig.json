{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/job-browser.tsx",
    "components/facility-request-form.tsx",
    "components/site-header.tsx",
    "components/site-footer.tsx",
    "components/ui/badge.tsx",
    "components/ui/button.tsx",
    "components/ui/dialog.tsx",
    "components/ui/input.tsx",
    "components/ui/label.tsx",
    "components/ui/select.tsx",
    "components/ui/textarea.tsx",
    "lib/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "examples",
    "build",
    "scripts"
  ]
}
